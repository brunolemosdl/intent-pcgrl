# Copy to .env and adjust as needed. Every variable is optional.
# The CLI loads this file automatically (shell variables always win over it).

# ---------------------------------------------------------------------------
# LLM bridge (description -> intent vector). Pick ONE provider via the
# `translator:` block in a config override YAML; the .env only holds keys.
# Install the SDKs with: .venv/bin/pip install -e 'packages/pcgrl-app[llm]'
# ---------------------------------------------------------------------------

# Default OpenAI-compatible provider (translator.model: gpt-5.2):
OPENAI_API_KEY=

# Google Gemini through its OpenAI-compatible endpoint:
#   translator:
#     provider: openai_compatible
#     model: gemini-3-pro-preview
#     base_url: https://generativelanguage.googleapis.com/v1beta/openai/
#     api_key_env: GEMINI_API_KEY
GEMINI_API_KEY=

# Any other OpenAI-compatible paid provider (Mistral, DeepSeek, Groq, ...):
# set base_url + model in the translator block and name the key variable via
# translator.api_key_env, e.g.:
#   translator:
#     provider: openai_compatible
#     model: mistral-large-latest
#     base_url: https://api.mistral.ai/v1
#     api_key_env: MISTRAL_API_KEY
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=

# Local models need NO key — just point base_url at the local server
# (the model must support structured outputs; Ollama >= 0.5 does):
#   translator:
#     provider: openai_compatible
#     model: qwen3:14b
#     base_url: http://localhost:11434/v1
# LM Studio: base_url: http://localhost:1234/v1
# vLLM:      base_url: http://localhost:8000/v1

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------

# Absolute path to the repository root. Only needed when running the CLI from
# outside the repo (installed wheels, notebooks); auto-detected otherwise.
PCGRL_REPO_ROOT=

# Matplotlib cache directory used by rendering (make exports this automatically).
MPLCONFIGDIR=.cache/matplotlib
